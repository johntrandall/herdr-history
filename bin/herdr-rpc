#!/usr/bin/env python3
"""Send one request to the Herdr socket API and print the raw reply.

Usage: herdr-rpc <method> [params-json]

Example: herdr-rpc pane.focus '{"pane_id":"w1:p2"}'

Needed because the CLI has no pane-focus-by-id: precise jumps to an arbitrary
pane go through the raw socket method `pane.focus`. Speaks the newline-framed
JSON protocol on $HERDR_SOCKET_PATH (Unix socket; herdr plugins target
linux/macos, so no named-pipe transport here).

Exit status: 0 when the reply carries a "result", 1 otherwise.
"""

import json
import os
import socket
import sys


def fail(msg: str) -> "NoReturn":
    print(f"herdr-rpc: {msg}", file=sys.stderr)
    sys.exit(1)


def main() -> None:
    if len(sys.argv) not in (2, 3):
        fail("usage: herdr-rpc <method> [params-json]")
    method = sys.argv[1]
    try:
        params = json.loads(sys.argv[2]) if len(sys.argv) == 3 else {}
    except json.JSONDecodeError as exc:
        fail(f"invalid params JSON: {exc}")
    path = os.environ.get("HERDR_SOCKET_PATH")
    if not path:
        fail("HERDR_SOCKET_PATH is not set (must be started by herdr as a plugin)")

    req = json.dumps({"id": "herdr-rpc", "method": method, "params": params}) + "\n"
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    sock.settimeout(2)
    try:
        sock.connect(path)
        sock.sendall(req.encode())
        line = sock.makefile().readline()
    except OSError as exc:
        fail(f"{method}: {exc}")
    finally:
        sock.close()

    line = line.strip()
    if not line:
        fail(f"{method}: empty response")
    try:
        payload = json.loads(line)
    except json.JSONDecodeError:
        fail(line)
    print(line)
    if "result" in payload:
        return
    err = payload.get("error")
    if isinstance(err, dict) and err.get("message"):
        fail(f"{method}: {err['message']}")
    fail(f"{method}: {line}")


if __name__ == "__main__":
    main()
